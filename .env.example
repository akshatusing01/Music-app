# Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App URL
APP_URL="MY_APP_URL"

# YouTube Data API v3
# Enable YouTube Data API v3 in Google Cloud and create a browser-restricted API key.
VITE_YOUTUBE_API_KEY="MY_YOUTUBE_DATA_API_KEY"

# Spotify playlist import (Authorization Code with PKCE)
# Register the exact production redirect URI in Spotify Developer Dashboard.
# Example: https://your-domain.example/
VITE_SPOTIFY_CLIENT_ID="MY_SPOTIFY_CLIENT_ID"
VITE_SPOTIFY_REDIRECT_URI="https://your-domain.example/"
